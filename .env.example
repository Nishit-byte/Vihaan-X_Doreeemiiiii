# ============================================================================
# VivaVoce Environment Configuration (.env.example)
# Copy this file to `.env` before running the backend server:
#   cp .env.example .env
# ============================================================================

# --- M1: AI Brain & Concept Graph Synthesis (Google Gemini 2.5 Flash) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- M3: Speech-to-Text (Groq Whisper Large v3 Turbo) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- M3: Text-to-Speech (Primary: edge-tts Neural Voice / Optional: ElevenLabs) ---
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-IN-PrabhatNeural
ELEVENLABS_API_KEY=your_optional_elevenlabs_api_key_here

# --- Server & Demo Settings ---
BACKEND_PORT=8000
OFFLINE_DEMO_FALLBACK=true
